# ---- CognoDB (graph database) ----
# Create a free c0 instance at https://cognodb.com and copy the connection string + password.
# The URI is Neo4j-compatible over Bolt, e.g. bolt+s://db-xxxx.databases.cognodb.cloud
COGNODB_URI=
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=

# ---- Server ----
# Port the Express API listens on (Render injects its own PORT in production).
PORT=4000

# Comma-separated list of allowed browser origins for CORS, or * to allow all.
# For local development the Vite dev server proxies /api, so this rarely matters.
# In production ("*" is ignored there unless set explicitly) this MUST list your
# deployed frontend origin(s); an unset value blocks all cross-origin browsers.
CLIENT_ORIGIN=*
